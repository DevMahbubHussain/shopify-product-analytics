# Copy to .env. Prisma loads it for session storage. Password must match DB_PASSWORD in the root .env.
# Host port 5433 maps to the Docker postgres service (5432 is left free for a local Postgres).
DATABASE_URL="postgresql://postgres:secret@localhost:5433/shopify_sessions"

# Laravel S2S endpoint. S2S_SHARED_SECRET must be identical to the root .env and backend/.env.
BACKEND_API_URL=http://localhost:8000
S2S_SHARED_SECRET=
