# Copy to .env and fill in. docker compose reads this file for variable interpolation.
# Generate: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
DB_DATABASE=shopify_analytics
DB_USERNAME=postgres
DB_PASSWORD=secret
# Generate: openssl rand -hex 32  (shared by backend, laravel-worker, shopify-app)
S2S_SHARED_SECRET=
