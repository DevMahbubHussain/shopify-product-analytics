# Copy to .env and fill in. docker compose reads this file for variable interpolation.
DB_DATABASE=shopify_analytics
DB_USERNAME=postgres
DB_PASSWORD=secret
# Generate: openssl rand -hex 32  (shared by backend, laravel-worker, shopify-app)
S2S_SHARED_SECRET=
# Dev Dashboard > App > Settings. Client ID is public; secret stays here only (never in backend/.env).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_orders
# Public HTTPS app URL. `shopify app dev` overrides it with the tunnel URL.
SHOPIFY_APP_URL=
